# McSMS Environment Configuration
# Copy this file to .env and update with your values

# Database Configuration
DB_HOST=localhost
DB_NAME=school_management_system
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Application Settings
APP_ENV=development
APP_DEBUG=false
APP_URL=http://localhost/McSMS

# Security
CSRF_SECRET=your-csrf-secret-key-here-min-32-chars
JWT_SECRET=your-jwt-secret-key-here-min-32-chars

# Email Configuration (PHPMailer)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@school.com
MAIL_FROM_NAME="School Management System"

# SMS Configuration (Twilio)
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# SMS Configuration (Hubtel)
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_SENDER_ID=

# Payment Gateway (Paystack)
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Payment Gateway (Hubtel)
HUBTEL_MERCHANT_ID=
HUBTEL_API_KEY=

# WhatsApp Business API
WHATSAPP_API_URL=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# File Upload Settings
UPLOAD_MAX_SIZE=10485760
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx,xls,xlsx
