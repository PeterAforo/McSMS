<IfModule mod_headers.c>
  # Never cache service worker - must always be fetched fresh
  <FilesMatch "sw\.js$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Never cache index.html - must always fetch fresh to get new asset hashes
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Serve real files directly (JS/CSS/images/etc under assets, icons, uploads, etc.)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Serve real directories directly
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Let the backend API and uploads handle their own paths
  RewriteRule ^backend/ - [L]
  RewriteRule ^uploads/ - [L]

  # Everything else is a frontend SPA route - serve index.html so React Router
  # can handle deep links and page refreshes (e.g. /login, /admin/students).
  RewriteRule ^ /index.html [L]
</IfModule>
